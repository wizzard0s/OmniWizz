{
  "name": "OmniWizz Master Workspace",
  "image": "://microsoft.com",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylance",
        "Continue.continue",
        "ms-azuretools.vscode-docker",
        "ckolkman.vscode-postgres"
      ]
    }
  },
  "runArgs": [
    "--net=host",
    "--userns=keep-id"
  ],
  "postCreateCommand": "pip install --upgrade pip && pip install psycopg2-binary asyncpg fastapi uvicorn pytest requests redis celery"
}
